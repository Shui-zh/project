<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pcd_to_pgm_demo</name>
  <version>1.0.0</version>
  <description>任务一: PCD 转占据栅格并发 /map;任务二: A* 规划并发 /path;任务三: Minimum Snap 轨迹优化</description>
  <maintainer email="dev@example.com">RMUL Demo Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>pcl_conversions</depend>
  <build_depend>libpcl-dev</build_depend>
  <exec_depend>libpcl-dev</exec_depend>
  <build_depend>eigen3_cmake_module</build_depend>
